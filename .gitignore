# Build intermediates.
# Directory.Build.props sends them outside the mod folder: they must never end up inside it,
# the whole folder being what goes to the Workshop as it stands.
.build/
Source/obj/
Source/bin/


# Development environments
.vs/
.vscode/
.idea/
.claude/
.firecrawl/
*.user
*.suo
*.csproj.user

# System
Thumbs.db
desktop.ini
.DS_Store

# Fiches de vitrine : elles ne sont pas publiables, et PUBLISHING.md demande de les effacer
# une fois Preview.png et ModIcon.png faits. A tout niveau, pas seulement a la racine.
PROMPT_*.md
**/PROMPT_*.md

# Compiled DirectDraw textures: never versioned (none are shipped today).
*.dds
**/*.dds

# Test evidence stays on disk, never in git (screenshots and Player.log grow without limit).
# The short text history lives in docs/runs/, one line per run.
Tests/Pickle/Evidence/
evidence/

Tests/UnitTests/bin/
Tests/UnitTests/obj/
