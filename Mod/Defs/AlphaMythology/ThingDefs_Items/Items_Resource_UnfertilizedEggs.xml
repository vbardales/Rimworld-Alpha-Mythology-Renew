<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Alpha Mythology declared fertilized eggs only. In 1.6 that is not enough:
       CompEggLayer calls ThingMaker.MakeThing(Props.eggUnfertilizedDef) as soon as a beast
       lays without having been fertilized, and throws if the field is null.

       Each egg below takes the texture and the value of its fertilized counterpart, minus
       whatever only makes sense for an egg that is going to hatch. -->

  <ThingDef ParentName="EggUnfertBase">
    <defName>MM_EggGriffinUnfertilized</defName>
    <label>griffin egg (unfert.)</label>
    <description>An unfertilized griffin egg. It can be eaten raw, but it's much, much better cooked.</description>
    <graphicData>
      <texPath>Things/Item/MM_EggGriffin</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(228,185,135)</color>
    </graphicData>
    <statBases>
      <MarketValue>9.0</MarketValue>
      <Nutrition>0.25</Nutrition>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="EggUnfertBase">
    <defName>MM_EggBasiliskUnfertilized</defName>
    <label>basilisk egg (unfert.)</label>
    <description>An unfertilized basilisk egg. It can be eaten raw, but it's much, much better cooked.</description>
    <graphicData>
      <texPath>Things/Item/MM_BasiliskEgg</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(228,185,135)</color>
    </graphicData>
    <statBases>
      <MarketValue>9.0</MarketValue>
      <Nutrition>0.25</Nutrition>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="EggUnfertBase">
    <defName>MM_EggFenghuangUnfertilized</defName>
    <label>fenghuang egg (unfert.)</label>
    <description>An unfertilized fenghuang egg. It can be eaten raw, but it's much, much better cooked.</description>
    <graphicData>
      <texPath>Things/Item/MM_FenghuangEgg</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(228,185,135)</color>
    </graphicData>
    <statBases>
      <MarketValue>9.0</MarketValue>
      <Nutrition>0.25</Nutrition>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="EggUnfertBase">
    <defName>MM_EggIeltxuUnfertilized</defName>
    <label>ieltxu egg (unfert.)</label>
    <description>An unfertilized ieltxu egg. It can be eaten raw, but it's much, much better cooked.</description>
    <graphicData>
      <texPath>Things/Item/MM_IeltxuEgg</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(228,185,135)</color>
    </graphicData>
    <statBases>
      <MarketValue>9.0</MarketValue>
      <Nutrition>0.25</Nutrition>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="EggUnfertBase">
    <defName>MM_EggStymphalianBirdUnfertilized</defName>
    <label>stymphalian bird egg (unfert.)</label>
    <description>An unfertilized stymphalian bird egg. It can be eaten raw, but it's much, much better cooked.</description>
    <graphicData>
      <texPath>Things/Item/MM_StymphalianBirdEgg</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(228,185,135)</color>
    </graphicData>
    <statBases>
      <MarketValue>9.0</MarketValue>
      <Nutrition>0.25</Nutrition>
    </statBases>
  </ThingDef>

  <!-- The salamander's holds its heat, like its fertilized counterpart: it inherits from
       MM_EggBaseHot and adds by hand what EggUnfertBase would have brought. -->
  <ThingDef ParentName="MM_EggBaseHot">
    <defName>MM_EggSalamanderUnfertilized</defName>
    <label>salamander egg (unfert.)</label>
    <description>An unfertilized salamander egg. It can be eaten raw, but it's much, much better cooked.</description>
    <ingestible>
      <preferability>RawBad</preferability>
    </ingestible>
    <thingCategories>
      <li>EggsUnfertilized</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/MM_SalamanderEgg</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(228,185,135)</color>
    </graphicData>
    <statBases>
      <MarketValue>9.0</MarketValue>
      <Nutrition>0.25</Nutrition>
    </statBases>
  </ThingDef>

</Defs>
