						<value>
							<li>Husky</li>
							<li>LabradorRetriever</li>
							<li>YorkshireTerrier</li>
						</value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="MM_Cerberus"]/race</xpath>
						<value>
							<canCrossBreedWith>
								<li>Husky</li>
								<li>LabradorRetriever</li>
								<li>YorkshireTerrier</li>
							</canCrossBreedWith>
